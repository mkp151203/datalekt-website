---
// A five-step WhatsApp automation; features.ts lights the steps in turn.
---

<div class="eff-vis" aria-hidden="true">
  <ol class="auto-steps">
    <li class="auto-step">
      <i></i>
      <span>
        <small>When</small>A table is booked
      </span>
    </li>
    <li class="auto-step">
      <i></i>
      <span>
        <small>Send</small>Confirmation on WhatsApp
      </span>
    </li>
    <li class="auto-step">
      <i></i>
      <span>
        <small>Wait</small>Until 90 min before arrival
      </span>
    </li>
    <li class="auto-step">
      <i></i>
      <span>
        <small>Send</small>“See you at 7:30, Ananya”
      </span>
    </li>
    <li class="auto-step">
      <i></i>
      <span>
        <small>Next day</small>“How was your evening?”
      </span>
    </li>
  </ol>
</div>
