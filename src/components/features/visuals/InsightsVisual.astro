---
// Tonight's covers counting up beside hourly bars; features.ts drives the count.
---

<div class="eff-vis" aria-hidden="true">
  <div class="ins-top">
    <span>
      Covers tonight
      <b class="ins-count" data-to="142">
        142
      </b>
    </span>
    <em>▲ 18% on last Friday</em>
  </div>
  <div class="ins-bars">
    <i style="--h: 30%"></i>
    <i style="--h: 48%"></i>
    <i style="--h: 72%"></i>
    <i style="--h: 100%"></i>
    <i style="--h: 86%"></i>
    <i style="--h: 58%"></i>
    <i style="--h: 34%"></i>
  </div>
  <div class="ins-axis">
    <span>6 pm</span>
    <span>9 pm</span>
    <span>12 am</span>
  </div>
  <p class="ins-row">
    <span>Returning guests</span>
    <b>38%</b>
  </p>
</div>
