---
// Scattered tools settle into one Datalekt window; features.ts toggles .is-tidy.
---

<div class="eff-vis" aria-hidden="true">
  <div class="tidy-window"><span class="tidy-bar"><img src="/brand/datalekt-mark.svg" alt="">Datalekt</span></div>
  <div class="tidy-grid">
    <span class="tidy-tile" style="--x: -18%; --y: -14%; --r: -9deg"><b>Spreadsheet</b><i></i><i></i><i></i></span>
    <span class="tidy-tile" style="--x: 16%; --y: -20%; --r: 7deg"><b>Register</b><i></i><i></i><i></i></span>
    <span class="tidy-tile" style="--x: -12%; --y: 18%; --r: 6deg"><b>Phone notes</b><i></i><i></i><i></i></span>
    <span class="tidy-tile" style="--x: 20%; --y: 12%; --r: -8deg"><b>Calendar</b><i></i><i></i><i></i></span>
  </div>
</div>
