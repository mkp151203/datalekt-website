---
// Use cases: six product scenes behind one set of tabs. Tab text comes from
// data/use-cases.ts; each scene is a component in scenes/. switcher.ts
// crossfades between them and moves on when a scene's loop ends.
import { getUseCases, type UseCase } from '../../data/use-cases';
import PosScene from './scenes/pos/Scene.astro';
import TableViewScene from './scenes/table-view/Scene.astro';
import BookingPortalScene from './scenes/booking-portal/Scene.astro';
import MessagingScene from './scenes/messaging/Scene.astro';
import OutletPageScene from './scenes/outlet-page/Scene.astro';
import GuestDatabaseScene from './scenes/guest-database/Scene.astro';
import './use-cases.css';

const scenes: Record<UseCase['scene'], typeof PosScene> = {
  pos: PosScene,
  'table-view': TableViewScene,
  'booking-portal': BookingPortalScene,
  messaging: MessagingScene,
  'outlet-page': OutletPageScene,
  'guest-database': GuestDatabaseScene,
};
const useCases = getUseCases();
---

<section class="cases" id="use-cases" aria-labelledby="cases-title">
  <div class="cases-head">
    <h2 class="cases-title" id="cases-title">
      One platform, <em>every part of the visit.</em>
    </h2>
  </div>

  <div class="cases-body">
    <div class="case-tabs" role="tablist" aria-label="Use cases">
      {useCases.map((useCase, i) => (
        <button
          class="case-tab"
          type="button"
          role="tab"
          id={`case-tab-${i + 1}`}
          aria-controls={`case-panel-${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? undefined : '-1'}
        >
          <span class="case-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="case-name">{useCase.name}</span>
          <span class="case-desc">{useCase.description}</span>
          <span class="case-progress" aria-hidden="true">
            <i></i>
          </span>
        </button>
      ))}
    </div>

    <p class="case-note" aria-live="polite">
      {useCases[0].description}
    </p>

    <div class="case-stage">
      {useCases.map((useCase, i) => {
        const Scene = scenes[useCase.scene];
        return (
          <div
            class:list={['case-panel', { 'is-on': i === 0 }]}
            id={`case-panel-${i + 1}`}
            role="tabpanel"
            aria-labelledby={`case-tab-${i + 1}`}
            hidden={i !== 0}
          >
            <Scene />
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { initAll } from '../../scripts/lib/in-view';
  import { initUseCaseSwitcher } from './switcher';

  initAll('.cases', initUseCaseSwitcher);
</script>
