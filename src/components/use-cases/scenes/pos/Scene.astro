---
// Use case 1: Datalekt and the restaurant POS, in sync both ways.
// Based on the product recording (video6): a booking made in
// Datalekt opens the table on Oracle Simphony, and the bill rung up
// on the POS flows back into the guest's Datalekt profile.
// scene.ts plays it; UseCases.astro shows it in the switcher.
import './scene.css';
---

<div class="uc-wrap" data-scene="pos">
  <div class="uc-scene" role="img" aria-label="A reservation made in Datalekt for Ananya Rao at table 4 opens a check on the POS; the bill rung up on the POS syncs back to her Datalekt profile.">
    <svg class="uc-links uc-links-wide" viewBox="0 0 1100 560" aria-hidden="true">
      <path pathLength="1" d="M530 140 C 580 140, 580 120, 640 120"/>
      <path pathLength="1" d="M640 330 C 580 330, 580 390, 530 390"/>
    </svg>
    <svg class="uc-links uc-links-stack" viewBox="0 0 600 980" aria-hidden="true">
      <path pathLength="1" d="M440 442 C 440 500, 470 500, 470 550"/>
      <path pathLength="1" d="M130 550 C 130 500, 160 500, 160 442"/>
    </svg>
    <span class="uc-packet uc-packet-wide" style="offset-path: path('M530 140 C 580 140, 580 120, 640 120')"></span>
    <span class="uc-packet uc-packet-wide" style="offset-path: path('M640 330 C 580 330, 580 390, 530 390')"></span>
    <span class="uc-packet uc-packet-stack" style="offset-path: path('M440 442 C 440 500, 470 500, 470 550')"></span>
    <span class="uc-packet uc-packet-stack" style="offset-path: path('M130 550 C 130 500, 160 500, 160 442')"></span>

    <!-- Datalekt on the restaurant's tablet -->
    <div class="uc-tablet">
      <div class="uc-screen">
        <div class="uc-bar"><img src="/brand/datalekt-mark.svg" alt="">Datalekt<span>UKIYO · Tonight</span></div>

        <div class="uc-pane uc-find is-on">
          <h5>Find a guest</h5>
          <div class="uc-input"><small>+91</small><span class="uc-typed"></span><i class="uc-caret"></i></div>
          <div class="uc-result">
            <span class="uc-avatar">AR</span>
            <div><b>Ananya Rao</b><small>Returning guest · 6th visit · last at UKIYO</small></div>
            <div class="uc-btns"><span class="uc-btn ghost">View</span><span class="uc-btn uc-reserve">Reserve</span></div>
          </div>
        </div>

        <div class="uc-pane uc-book">
          <div class="uc-fields">
            <h5>Reservation</h5>
            <div class="uc-field"><small>Guest</small>Ananya Rao</div>
            <div class="uc-field"><small>Mobile</small>+91 98190 43344</div>
            <div class="uc-field"><small>Date and time</small>Tonight · 7:30 pm</div>
            <div class="uc-field"><small>Guests</small>4</div>
            <div class="uc-outlets"><span class="on">UKIYO</span><span>Alta Vida</span><span>Praja</span><span>RCTL</span></div>
          </div>
          <div class="uc-plan">
            <i>T1</i><i class="busy">T2</i><i>T3</i><i class="uc-t4">T4</i>
            <i class="busy">T5</i><i>T6</i><i class="busy">T7</i><i>T8</i>
            <i>T9</i><i class="busy">T10</i><i>T11</i><i>T12</i>
            <i class="busy">T13</i><i>T14</i><i>T15</i><i class="busy">T16</i>
          </div>
          <span class="uc-submit">Submit</span>
        </div>

        <div class="uc-pane uc-dash">
          <div class="uc-days"><span><b>1</b>Yesterday</span><span class="today"><b class="uc-today">3</b>Today</span><span><b>0</b>Tomorrow</span></div>
          <div class="uc-cards">
            <div class="uc-card new">
              <b>Ananya Rao</b>
              <div class="uc-tags"><span>7:30 pm</span><span>4 guests</span><span>T4</span><span>UKIYO</span><span class="uc-spend"><span>₹1,360</span></span></div>
              <p class="uc-note">Booking created on POS</p>
              <p class="uc-note uc-synced">Bill synced from POS</p>
            </div>
            <div class="uc-card">
              <b>Rahul Mehta</b>
              <div class="uc-tags"><span>8:00 pm</span><span>2</span><span>T11</span></div>
              <p class="uc-note">Booking created from POS</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- The restaurant's POS terminal -->
    <div class="uc-pos">
      <div class="uc-pos-screen">
        <div class="uc-pos-ui">
          <div class="uc-pos-top"><b>Simphony POS</b><span>UKIYO · Dine in</span></div>

          <div class="uc-pos-pane uc-checks is-on">
            <h6>Open checks</h6>
            <div class="uc-check new"><b>TBL 4</b><span>Ananya Rao · 4 guests</span><em>via Datalekt</em></div>
            <div class="uc-check"><b>TBL 2</b><span>Walk-in · 2 guests</span><span>₹980</span></div>
            <div class="uc-check"><b>TBL 7</b><span>Kapoor · 6 guests</span><span>₹4,210</span></div>
            <div class="uc-check"><b>TBL 10</b><span>Iyer · 2 guests</span><span>₹640</span></div>
          </div>

          <div class="uc-pos-pane uc-ticket-pane">
            <div class="uc-ticket-grid">
              <div class="uc-ticket">
                <div class="uc-ticket-head"><b>TBL 4 · Dine in</b>Ananya Rao · CHK 103</div>
                <div class="uc-items">
                  <p class="uc-item"><span>1 Edamame</span><span>320</span></p>
                  <p class="uc-item"><span>1 Salmon nigiri</span><span>540</span></p>
                  <p class="uc-item"><span>1 Café au lait</span><span>260</span></p>
                  <p class="uc-item"><span>1 Decaf</span><span>240</span></p>
                </div>
                <div class="uc-total"><span>Total due</span><span>₹<span class="uc-sum">0</span></span></div>
              </div>
              <div class="uc-menu">
                <span data-hit="0">Edamame</span><span>Gyoza</span><span>Miso soup</span>
                <span data-hit="1">Salmon nigiri</span><span>Tuna roll</span><span>Tempura</span>
                <span data-hit="2">Café au lait</span><span>Espresso</span><span data-hit="3">Decaf</span>
                <span class="mod">Extra hot</span><span class="mod">Oat milk</span><span class="mod">No foam</span>
              </div>
            </div>
            <div class="uc-pos-actions"><span>Seats</span><span>Fire order</span><span>Print</span><span class="send">Send</span></div>
          </div>
        </div>
      </div>
      <div class="uc-pos-neck"></div>
      <div class="uc-pos-foot"></div>
    </div>

    <p class="uc-flow uc-flow-book">Booking <span class="arr-wide">→</span><span class="arr-stack">↓</span></p>
    <p class="uc-flow uc-flow-bill"><span class="arr-wide">←</span><span class="arr-stack">↑</span> Bill</p>
    <p class="uc-chip uc-chip-book"><i></i>Booking created on POS</p>
    <p class="uc-chip uc-chip-bill"><i></i>Bill synced to guest profile</p>
    <p class="uc-label uc-label-tablet">Datalekt</p>
    <p class="uc-label uc-label-pos">Restaurant POS</p>

    <span class="uc-tap" aria-hidden="true"></span>
  </div>
</div>

<script>
  import { initAll } from '../../../../scripts/lib/in-view';
  import { initScene } from './scene';

  initAll('[data-scene="pos"]', initScene);
</script>
