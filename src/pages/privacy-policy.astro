---
// Privacy policy, from src/content/legal/privacy-policy.md
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const policy = await getEntry('legal', 'privacy-policy');
if (!policy) throw new Error('Missing src/content/legal/privacy-policy.md');
const { Content } = await render(policy);
---

<PageLayout
  title={policy.data.title}
  description="How Datalekt collects, uses, stores and protects your personal information."
  meta={`Last updated: ${policy.data.lastUpdated}`}
>
  <Content />
</PageLayout>
