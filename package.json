{
  "name": "datalekt-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Datalekt marketing website: guest data, reservations and messaging for hotel restaurants.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4173",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "reference": "python3 -m http.server 4174 --bind 0.0.0.0 --directory archive/static-prototype",
    "map": "python3 -I tools/build-india-map.py",
    "og": "node tools/render-og-image.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "browserslist": "4.29.5",
    "lightningcss": "1.33.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
